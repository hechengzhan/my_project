LLM_PROVIDER=coze
COZE_BASE_URL=https://api.coze.cn
COZE_API_TOKEN=your_coze_api_token
COZE_BOT_ID=your_coze_bot_id
COZE_USER_ID=campus-web-user
COZE_TIMEOUT=60

# =========================
# DeepSeek 通用大模型配置
# 用于：普通闲聊、校园问答兜底、天气失败兜底
# =========================
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

WEATHER_PROVIDER=mock
WEATHER_CITY_NAME=校园所在地
WEATHER_CITY_CODE=440100
AMAP_WEATHER_KEY=your_amap_weather_key
MOCK_WEATHER=多云，气温 26°C，适合出行

# =========================
# 新闻模块配置
# mock：模拟新闻；newsapi：NewsAPI.org 兼容；custom：自定义 GET 新闻接口
# =========================
NEWS_PROVIDER=mock
NEWS_API_URL=https://newsapi.org/v2/top-headlines
NEWS_API_KEY=your_news_api_key
NEWS_COUNTRY=cn
NEWS_PAGE_SIZE=5
NEWS_API_KEY_PARAM=key
NEWS_API_AUTH_TYPE=query
NEWS_API_SIZE_PARAM=num
NEWS_API_EXTRA_PARAMS=
MOCK_NEWS=今日校园新闻模拟：学校近期将举行学术讲座、社团活动和就业指导分享会。
